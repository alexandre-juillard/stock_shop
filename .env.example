SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

PGADMIN_EMAIL=admin@stockshop.fr
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Secret utilisé pour signer les JWT (access + refresh token).
# Générer une valeur aléatoire d'au moins 64 octets encodée en base64, par exemple :
#   PowerShell : [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   Bash       : openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
