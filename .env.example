SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

PGADMIN_EMAIL=admin@stockshop.fr
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Secret utilisé pour signer les JWT (access + refresh token).
# Générer une valeur aléatoire d'au moins 64 octets encodée en base64, par exemple :
#   PowerShell : [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   Bash       : openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
# Durée (ms) du refresh token quand rememberMe=false/absent à la connexion (session non mémorisée).
SESSION_DEFAULT_EXPIRATION=43200000

# Serveur SMTP pour l'envoi d'emails (confirmation de compte, réinitialisation de mot de passe).
# En développement local, laisser vide : le profil "dev" pointe automatiquement vers Mailpit
# (voir docker-compose.yaml), une interface web de consultation des emails reçus
# est disponible sur http://localhost:8025 sans compte SMTP réel nécessaire.
# Pour utiliser un service externe (ex: Mailtrap Sandbox), renseigner les valeurs fournies par
# le service, par exemple :
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=xxxxxxxxxxxxxx
#   SMTP_PASSWORD=xxxxxxxxxxxxxx
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@stockshop.fr

# Durée de validité des jetons de confirmation de compte / réinitialisation de mot de passe.
TOKEN_EXPIRATION=24h

# Base URL de l'application front (utilisée pour construire les liens envoyés par email).
FRONTEND_BASE_URL=http://localhost:3000

# Identifiants OAuth2 Google (Google Cloud Console > API et services > Identifiants).
# Redirect URI à déclarer côté Google : {URL_PUBLIQUE_API}/api/auth/oauth2/callback
# (ex: http://localhost:8080/api/auth/oauth2/callback en local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

